{
  "name": "@edfm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "discord:test": "tsx --env-file-if-exists=.env src/tools/discord-test.ts"
  },
  "dependencies": {
    "@edfm/verification": "*",
    "@fastify/rate-limit": "^10.1.1",
    "fastify": "^5.1.0",
    "pg": "^8.13.1",
    "tsx": "^4.23.13",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
