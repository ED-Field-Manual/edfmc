{
  "name": "edfm-companion",
  "private": true,
  "version": "0.1.0",
  "description": "Official desktop companion for the Elite Dangerous Field Manual",
  "workspaces": [
    "packages/*",
    "apps/desktop",
    "services/api"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
